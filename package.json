{
  "name": "qrcode-generator-poc",
  "description": "QR code generator API based on QuickChart",
  "version": "1.0.0",
  "main": "index.js",
  "license": "AGPL-3.0",
  "homepage": "https://quickchart.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/typpo/quickchart.git"
  },
  "engines": {
    "node": "16.x"
  },
  "scripts": {
    "preinstall": "npm install -g node-gyp",
    "start": "node --max-http-header-size=65536 index.js",
    "format": "prettier --write \"**/*.js\"",
    "test": "PORT=3401 NODE_ENV=test mocha --exit --recursive test/ci/",
    "test:watch": "PORT=2998 NODE_ENV=test chokidar '**/*.js' --initial --ignore node_modules -c 'mocha --exit --recursive test/'"
  },
  "dependencies": {
    "bunyan": "^1.8.15",
    "canvas": "^2.11.2",
    "canvas-5-polyfill": "^0.1.5",
    "chart.js": "^3.9.1",
    "chartjs-adapter-moment": "^1.0.1",
    "chartjs-chart-box-and-violin-plot": "^3.0.0",
    "chartjs-chart-radial-gauge": "^1.1.0",
    "chartjs-node-canvas": "^4.1.6",
    "chartjs-plugin-annotation": "^2.1.2",
    "chartjs-plugin-datalabels": "^2.2.0",
    "deepmerge": "^4.3.1",
    "express": "^4.19.2",
    "express-rate-limit": "^6.7.0",
    "get-image-colors": "^4.0.1",
    "javascript-stringify": "^2.1.0",
    "node-fetch": "^2.6.9",
    "patternomaly": "^1.3.2",
    "pdfkit": "^0.13.0",
    "qrcode": "^1.5.1",
    "qs": "^6.11.1",
    "sharp": "^0.32.6",
    "text2png": "^2.3.0"
  },
  "devDependencies": {
    "@evilmartians/lefthook": "^1.3.9",
    "chokidar-cli": "^3.0.0",
    "eslint": "^8.36.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5",
    "image-size": "^1.0.2",
    "jimp": "^0.22.7",
    "mocha": "^10.2.0",
    "pixelmatch": "^5.3.0",
    "prettier": "^2.8.7",
    "qrcode-reader": "^1.0.4",
    "supertest": "^6.3.3"
  },
  "peerDependencies": {
    "chart.js": ">= 3.0.0"
  }
}

